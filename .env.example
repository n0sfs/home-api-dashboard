# Copy this file to .env to override defaults. Never commit .env.

PORT=4200
ROUTER_BASE_URL=http://192.168.86.1
# How often to run a real download/upload speedtest, in seconds. Each run saturates
# the connection for ~10-20s and uses real data (tens to hundreds of MB). 3600 = hourly,
# aligned to the top of the hour.
SPEEDTEST_INTERVAL_SECONDS=3600
# Optional: comma-separated speedtest server upload URLs to pin to, if the defaults
# (two Charlotte, NC servers) ever go stale. speedtest-cli's own "closest server"
# auto-discovery uses speedtest.net's IP geolocation, which was badly wrong for this
# connection (off by ~1200km) — find real nearby servers by searching
# https://www.speedtest.net/api/js/servers?engine=js&search=<your city>&limit=10
# SPEEDTEST_SERVER_URLS=http://host1/speedtest/upload.php,http://host2/speedtest/upload.php
